# Copy to .env.local and change both values before sharing the app with anyone.

# Password for the administrator area (/admin). Use a long passphrase.
ADMIN_PASSWORD=change-this-to-a-long-passphrase

# Random secret used to sign admin session cookies (32+ random characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Launch setup: Supabase database + individual admin accounts ---
# When all three are set, the app stores everything in Supabase and admins
# sign in with their own email and password (ADMIN_PASSWORD is then unused).
# Find them in Supabase: Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET: server only. Never put this in client code or share it.
SUPABASE_SERVICE_ROLE_KEY=
